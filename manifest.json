{
  "manifest_version": 3,
  "name": "Lichess Grey Board for Chess.com",
  "version": "1.0.0",
  "description": "The original Lichess grey board texture on Chess.com. Keeps your pieces and game controls.",
  "browser_specific_settings": {
    "gecko": {
      "id": "lichess-grey-board@local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.chess.com/*",
        "https://chess.com/*"
      ],
      "css": [
        "board.css"
      ],
      "css_origin": "user",
      "run_at": "document_start"
    }
  ]
}
